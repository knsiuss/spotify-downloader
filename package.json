{
  "name": "drop-media-downloader",
  "version": "0.3.1",
  "description": "DROP — Media Downloader: Spotify & YouTube ke WAV/FLAC/MP3 + MP4/WEBM/MKV (lokal, tanpa akun Spotify)",
  "type": "module",
  "bin": {
    "spotdlr": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run download-bins && tsc && node scripts/write-server-pkg.mjs && npm run build:web",
    "build:web": "cd web && npx next build",
    "download-bins": "node scripts/download-bins.mjs",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/server.js",
    "server": "node dist/server.js",
    "web": "cd web && npx next dev -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}