{
  "name": "drop-desktop",
  "version": "0.2.0",
  "description": "DROP — Media Downloader (desktop shell)",
  "main": "main.js",
  "author": "Quincy",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.quincy.drop",
    "productName": "DROP",
    "directories": {
      "output": "../release",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../dist", "to": "server/dist" },
      { "from": "../web/out", "to": "ui" },
      { "from": "../bin", "to": "bin" }
    ],
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DROP"
    }
  }
}
