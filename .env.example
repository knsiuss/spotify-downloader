# Qobuz provider (opsional, untuk source lossless FLAC -> WAV)
# Cara dapat app_id + app_secret: riset unofficial API Qobuz (berubah-ubah, tidak resmi)
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
# Cookies YouTube (opsional) - kurangi 403/rate-limit
YT_COOKIES=

# Jeda minimum antar spawn yt-dlp (ms)
DROP_YT_MIN_GAP_MS=1400

# Percobaan ulang download video (per file) + timeout per percobaan (ms)
DROP_VIDEO_RETRIES=3
DROP_VIDEO_TIMEOUT_MS=600000
